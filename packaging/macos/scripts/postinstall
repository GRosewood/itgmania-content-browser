#!/bin/bash
# Runs after Installer.app copies the helper into place. It performs the same
# work as the console installer (auto-detect ITGmania, copy the module, enable
# the network allowlist) and surfaces failures in Installer.app's log.
set -uo pipefail

HELPER="/usr/local/share/itgmania-content-browser/itgmania-content-browser-installer"
[ -x "$HELPER" ] || { echo "helper missing at $HELPER" >&2; exit 1; }

# Installer.app runs as root; detect against the console user's home so
# ~/Library and ~/.itgmania installs are found.
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    su - "$CONSOLE_USER" -c "'$HELPER' -y -no-banner" && exit 0
    echo "install as $CONSOLE_USER failed; retrying as current user" >&2
fi

"$HELPER" -y -no-banner
